# ========================
# 基础配置
# ========================
APP_NAME=YYC3_Document_System
APP_ENV=development
APP_PORT=3000
APP_SECRET=your_app_secret_key

# ========================
# 数据库配置
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yyc3_dev
DB_USER=postgres
DB_PASSWORD=postgres

# ========================
# 缓存配置
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# 存储配置
# ========================
STORAGE_TYPE=local # 可选: webdav, s3, local
WEBDAV_SERVER=https://your-webdav-server.com
WEBDAV_USER=username
WEBDAV_PASSWORD=password
S3_ACCESS_KEY=your_s3_key
S3_SECRET=your_s3_secret
S3_BUCKET=your_bucket_name
S3_REGION=us-east-1

# ========================
# AI 服务配置
# ========================
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo
LOCAL_AI_ENDPOINT=http://localhost:5000
LOCAL_AI_TOKEN=local_ai_token

# ========================
# 区块链配置
# ========================
BLOCKCHAIN_NETWORK=testnet
BLOCKCHAIN_API_KEY=your_blockchain_api_key
FABRIC_CHANNEL_NAME=yyc3-channel

# ========================
# 协作服务配置
# ========================
WS_SERVER=ws://localhost:8080
RTC_SIGNALING_SERVER=http://localhost:3001
RTC_STUN_SERVER=stun:stun.l.google.com:19302
